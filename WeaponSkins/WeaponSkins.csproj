<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<AssemblyName>WeaponSkins</AssemblyName>
		<RootNamespace>WeaponSkins</RootNamespace>
		<Version>1.1.0</Version>
		<GenerateDependencyFile>false</GenerateDependencyFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CounterStrikeSharp.API" Version="1.0.371" />
		<PackageReference Include="Discord.Net" Version="3.20.1" />
		<PackageReference Include="MySqlConnector" Version="2.4.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="Data\**" CopyToOutputDirectory="PreserveNewest" Link="Data\%(Filename)%(Extension)" />
		<None Include="Lang\**" CopyToOutputDirectory="PreserveNewest" Link="lang\%(Filename)%(Extension)" />
		<None Include="gamedata\**" CopyToOutputDirectory="PreserveNewest" Link="gamedata\%(Filename)%(Extension)" />
	</ItemGroup>

</Project>
